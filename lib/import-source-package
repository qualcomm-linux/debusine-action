# Validate a source package produced by an untrusted run (for example a fork
# pull_request hook) and stage it in $PWD for the build job.
#
# Everything under $1 is attacker-controlled data. This script must never
# execute, source, or unpack it, and must re-derive every value it outputs
# from the .dsc itself, constrained to Debian policy character sets. It only
# checks shape and integrity; the actual trust boundary is Debusine's own
# build sandbox, which is the only place the package is built.

# Inputs:
#     $1: directory containing the downloaded source-package artifact
# Outputs:
#     $PWD: the validated .changes file together with all referenced files
#     $GITHUB_OUTPUT (append): srcpkg_name, srcpkg_version, changes_path,
#         dsc_path

: ${GITHUB_OUTPUT:=/dev/null}

src_dir="$1"
[ -d "$src_dir" ] || { echo "Missing source package directory: $src_dir" >&2; exit 1; }

# Flat directory of regular files only: no subdirectories, symlinks, or
# names that could escape $PWD or confuse later globbing.
if find "$src_dir" -mindepth 1 \( ! -type f -o -path "$src_dir/*/*" \) -print -quit | grep -q .; then
    echo "Source package artifact must contain only regular files at top level" >&2
    exit 1
fi
if find "$src_dir" -mindepth 1 -type f ! -name '[A-Za-z0-9]*' -print -quit | grep -q . \
    || find "$src_dir" -mindepth 1 -type f -name '*[!A-Za-z0-9.+~_-]*' -print -quit | grep -q .; then
    echo "Source package artifact contains unexpected file names" >&2
    exit 1
fi

shopt -s nullglob
changes=( "$src_dir"/*.changes )
dscs=( "$src_dir"/*.dsc )
if [ "${#changes[@]}" -ne 1 ] || [ "${#dscs[@]}" -ne 1 ]; then
    echo "Expected exactly one .changes and one .dsc, found ${#changes[@]} and ${#dscs[@]}" >&2
    exit 1
fi

# Every file the .changes lists must be present and match its checksums,
# and nothing else may be present.
listed=$(cd "$src_dir" && dcmd echo "$(basename "${changes[0]}")" | tr ' ' '\n' | sort)
present=$(cd "$src_dir" && ls -1 | sort)
if [ "$listed" != "$present" ]; then
    echo "Source package artifact files do not match the .changes file list" >&2
    diff <(echo "$listed") <(echo "$present") >&2 || true
    exit 1
fi
(
    cd "$src_dir"
    changes_file=$(basename "${changes[0]}")
    grep-dctrl -n -s Checksums-Sha256 . "$changes_file" | awk 'NF==3 {print $1"  "$3}' | sha256sum --strict -c --quiet -
)

# The .dsc must be referenced by the .changes, not just sitting next to it.
dsc_name=$(basename "${dscs[0]}")
if ! (cd "$src_dir" && dcmd --dsc echo "$(basename "${changes[0]}")") | grep -qxF "$dsc_name"; then
    echo "The .dsc is not the one referenced by the .changes" >&2
    exit 1
fi

srcpkg_name=$(grep-dctrl -n -s Source . "${dscs[0]}")
srcpkg_version=$(grep-dctrl -n -s Version . "${dscs[0]}")
if ! [[ "$srcpkg_name" =~ ^[a-z0-9][a-z0-9.+-]+$ ]]; then
    echo "Invalid Source in .dsc" >&2
    exit 1
fi
if ! [[ "$srcpkg_version" =~ ^[A-Za-z0-9.+~:-]+$ ]]; then
    echo "Invalid Version in .dsc" >&2
    exit 1
fi

mv -t . "$src_dir"/*
rmdir "$src_dir"

cat >> "$GITHUB_OUTPUT" <<END
srcpkg_name=$srcpkg_name
srcpkg_version=$srcpkg_version
changes_path=$(basename "${changes[0]}")
dsc_path=$dsc_name
END
