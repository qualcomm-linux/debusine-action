# Fetch a Debusine workspace's archive signing key (signing-keys.asc), retrying
# until a valid key is returned.
#
# This works around a Debusine race: immediately after a build publishes to a
# freshly created workspace, signing-keys.asc can briefly return a well-formed
# but empty PGP armor block (headers and the "=CRC24" checksum only, with no
# key packet data) instead of a 404. Callers that need the key of an ephemeral
# build workspace right after the build completes hit this. Long-lived
# workspaces already have their key, so they do not need this script and can
# fetch signing-keys.asc with a plain curl.
#
# Project bug: https://github.com/qualcomm-linux/debusine-action/issues/93
# Upstream bug:
# https://salsa.debian.org/freexian-team/debusine/-/work_items/1569

# Run on the host (or in the builder container).

# Dependencies:
#   ca-certificates and curl packages
#   debusine-action/lib/signing-key-is-valid (invoked via that relative path, as
#     poll_workflow.py is, so run this as debusine-action/lib/fetch-signing-key)

# Inputs:
#   DEBUSINE_HOST
#   DEBUSINE_SCOPE
#   DEBUSINE_USER
#   DEBUSINE_TOKEN
#   DEBUSINE_WORKSPACE

# Outputs:
#   stdout: the ASCII-armored signing key

# Retry every RETRY_INTERVAL seconds until a valid key is returned or MAX_WAIT
# seconds have elapsed.
RETRY_INTERVAL=10
MAX_WAIT=300

url="https://deb.${DEBUSINE_HOST}/${DEBUSINE_SCOPE}/${DEBUSINE_WORKSPACE}/signing-keys.asc"

tmp_body="$(mktemp)"
tmp_err="$(mktemp)"

cleanup_tmp() {
    rm -f "$tmp_body" "$tmp_err"
}

trap cleanup_tmp EXIT INT TERM HUP

waited=0
while :; do
    http_code="$(curl -sSu "${DEBUSINE_USER}:${DEBUSINE_TOKEN}" \
        -o "$tmp_body" \
        -w '%{http_code}' \
        "$url" 2>"$tmp_err" || true)"

    case "$http_code" in
        401|403)
            echo "fetch-signing-key: auth failed (HTTP ${http_code}) for ${DEBUSINE_WORKSPACE}; check DEBUSINE_USER/DEBUSINE_TOKEN" >&2
            if [ -s "$tmp_err" ]; then
                cat "$tmp_err" >&2
            fi
            exit 1
            ;;
        200)
            key="$(cat "$tmp_body")"
            if printf '%s' "$key" | debusine-action/lib/signing-key-is-valid; then
                printf '%s' "$key"
                exit 0
            fi
            ;;
    esac

    if [ -s "$tmp_err" ]; then
        cat "$tmp_err" >&2
    fi
    if [ "$waited" -ge "$MAX_WAIT" ]; then
        echo "fetch-signing-key: gave up waiting for a valid signing key for" \
             "${DEBUSINE_WORKSPACE} after ${MAX_WAIT}s" >&2
        exit 1
    fi
    echo "fetch-signing-key: signing-keys.asc for ${DEBUSINE_WORKSPACE} not" \
         "ready (HTTP ${http_code}); retrying in ${RETRY_INTERVAL}s" \
         "(waited ${waited}s)" >&2
    sleep "$RETRY_INTERVAL"
    waited=$((waited + RETRY_INTERVAL))
done
