version=4

# Backport of a version=5 watch file for use with the uscan shipped in
# devscripts 2.25.15+deb13u1 (Debian 13 "trixie"), which only understands the
# classic single-line watch format and has no "gitlab" download mode.
#
# Behaviour is identical to the version=5 original under a newer uscan:
#   * main source resolves github.com/.../releases/download/<tag>/..._<tag>.tar.gz
#     (+ detached .asc signature)
#   * component "firmware" resolves the GitLab repository archive for the tag.

# Main upstream source (GitHub).
# The version=5 "Source:" scraped the GitHub refs API in plain mode and used
# Download-Url-Mangle to turn the matched refs URL into the release tarball URL.
opts="searchmode=plain,\
dversionmangle=s%^0~%%,\
oversionmangle=s%^%0~%,\
pgpsigurlmangle=s%$%.asc%,\
downloadurlmangle=s%api.github.com/repos/([^/]+)/([^/]+)/git/refs/tags/@ANY_VERSION@%github.com/$1/$2/releases/download/$3/$2_$3.tar.gz%,\
filenamemangle=s%.*/@ANY_VERSION@%@PACKAGE@-$1.tar.gz%" \
https://api.github.com/repos/linux-msm/hexagon-dsp-binaries/git/matching-refs/tags/ \
https://api.github.com/repos/[^/]+/[^/]+/git/refs/tags/@ANY_VERSION@

# Component "firmware" (GitLab linux-firmware).
# The version=5 "Template: gitlab" used uscan's gitlab mode (GET /api/v4 project
# id, then /repository/tags, building archive.tar.gz?sha=<tag> URLs). That mode
# does not exist in this uscan, so we reproduce it with mode=http + plain
# search: scrape the tags API JSON directly (addressing the project by its
# URL-encoded path, kernel-firmware%2Flinux-firmware, which avoids the numeric
# project-id lookup) and build the same archive URL via downloadurlmangle.
# pgpmode=none mirrors the gitlab template default (no signatures).
opts="component=firmware,searchmode=plain,pgpmode=none,\
dversionmangle=s/^0~//,\
oversionmangle=s/^/0~/,\
downloadurlmangle=s#.*"name":"@ANY_VERSION@".*#https://gitlab.com/api/v4/projects/kernel-firmware%2Flinux-firmware/repository/archive.tar.gz?sha=$1#,\
filenamemangle=s#.*"name":"@ANY_VERSION@".*#@PACKAGE@-firmware-$1.tar.gz#" \
https://gitlab.com/api/v4/projects/kernel-firmware%2Flinux-firmware/repository/tags \
"name":"@ANY_VERSION@"
